// CloudVerge — Prisma schema
// Recreated from API route usage (the original Z.ai export shipped without it).
// SQLite keeps local setup zero-config. Swap provider to "postgresql" when
// you move to Supabase/Postgres — models are already compatible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  budget    String?
  message   String
  status    String   @default("new") // new | contacted | qualified | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String?
  content    String
  category   String   @default("Technology")
  authorName String   @default("CloudVerge Team")
  readTime   String   @default("5 min read")
  published  Boolean  @default(true)
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Project {
  id           String   @id @default(cuid())
  title        String
  clientName   String
  category     String
  description  String
  technologies String // comma-separated list
  impact       String?
  featured     Boolean  @default(false)
  imageSeed    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  clientName String
  company    String?
  industry   String?
  rating     Int
  content    String
  verified   Boolean  @default(false)
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Employee {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  role        String   @default("employee") // admin | employee
  position    String?
  department  String?
  avatarUrl   String?
  bio         String?
  linkedinUrl String?
  githubUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("todo") // todo | in-progress | review | done
  priority    String   @default("medium") // low | medium | high
  assigneeId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
